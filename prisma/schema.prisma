generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  WAREHOUSE_MANAGER
  PROCUREMENT_TEAM
  SALES_TEAM
  SERVICE_ADVISOR
  TECHNICIAN
  DEALER_ADMIN
  CASHIER
  QUALITY_INSPECTOR
  CUSTOMER
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RentalStatus {
  PENDING
  APPROVED
  ACTIVE
  RETURNED
  CANCELLED
}

enum ServiceStatus {
  REQUESTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  INTERESTED
  FOLLOW_UP
  QUOTATION_SENT
  CONVERTED
  CLOSED
}

enum RepairStatus {
  PRODUCT_RECEIVED
  INSPECTION
  ESTIMATE
  CUSTOMER_APPROVAL
  REPAIR
  QUALITY_CHECK
  CLEANING
  BILLING
  DELIVERED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

// ----------------------------------------------------
// USER & CUSTOMER ACCOUNTS
// ----------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  mobile       String    @unique
  name         String
  role         Role      @default(CUSTOMER)
  passwordHash String?
  avatar       String?
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  farmProfile   FarmProfile?
  addresses     CustomerAddress[]
  orders        Order[]
  rentals       RentalBooking[]
  services      ServiceRequest[]
  reviews       Review[]
  notifications CustomerNotification[]
  wallet        Wallet?
}

model OtpToken {
  id        String   @id @default(uuid())
  mobile    String
  codeHash  String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([mobile])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model CustomerAddress {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  mobile            String
  alternateMobile   String?
  addressLine       String
  landmark          String?
  taluk             String
  village           String
  district          String
  state             String   @default("Karnataka")
  pincode           String
  gpsLatitude       Float?
  gpsLongitude      Float?
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------
// CATALOGUE: BRAND, CATEGORY, PRODUCT, VARIANTS, MEDIA
// ----------------------------------------------------

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  description String?
  website     String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Category {
  id            String     @id @default(uuid())
  name          String
  nameKn        String?
  slug          String     @unique
  description   String?
  image         String?
  parentId      String?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryHierarchy")
  products      Product[]
  displayOrder  Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Product {
  id               String           @id @default(uuid())
  name             String
  nameKn           String?
  slug             String           @unique
  sku              String           @unique
  shortDescription String?
  description      String
  brandId          String?
  brand            Brand?           @relation(fields: [brandId], references: [id])
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  
  price            Float
  comparePrice     Float?
  
  isPublished      Boolean          @default(true)
  isDraft          Boolean          @default(false)
  isFeatured       Boolean          @default(false)
  isBestSeller     Boolean          @default(false)
  
  targetCrops      String?          // Comma-separated crops e.g. "Paddy, Cotton, Sugarcane"
  cropStages       String?          // Comma-separated stages e.g. "1,2,3"
  
  // SEO fields
  metaTitle        String?
  metaDescription  String?
  ogImage          String?
  canonicalUrl     String?

  variants         ProductVariant[]
  media            Media[]
  specifications   Specification[]
  reviews          Review[]
  orderItems       OrderItem[]
  warehouseStocks  WarehouseStock[]
  stockReservations StockReservation[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([slug])
}

model ProductVariant {
  id               String           @id @default(uuid())
  productId        String
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku              String           @unique
  title            String           // e.g. "1 Litre Bottle", "5 Litre Can", "7 HP Petrol"
  variantName      String           // e.g. "1L", "5L", "7HP"
  price            Float
  comparePrice     Float?
  weightKg         Float?
  unit             String?          // e.g. "Litre", "Kg", "Unit"
  barcode          String?
  isDefault        Boolean          @default(false)
  stockQuantity    Int              @default(0)

  media            Media[]
  orderItems       OrderItem[]
  warehouseStocks  WarehouseStock[]
  stockReservations StockReservation[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([productId])
}

model Media {
  id               String          @id @default(uuid())
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url              String
  altText          String?
  type             MediaType       @default(IMAGE)
  isPrimary        Boolean         @default(false)
  displayOrder     Int             @default(0)
  createdAt        DateTime        @default(now())

  @@index([productId])
}

model Specification {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  group        String   @default("General") // e.g. "Engine & Performance", "Application & Dosage"
  name         String   // e.g. "Engine Power", "Active Ingredient"
  value        String   // e.g. "7.5 HP 4-Stroke Petrol", "Azadirachtin 10000 PPM"
  displayOrder Int      @default(0)

  @@index([productId])
}

// ----------------------------------------------------
// INVENTORY & MULTI-WAREHOUSE STOCK
// ----------------------------------------------------

model Warehouse {
  id               String           @id @default(uuid())
  name             String
  code             String           @unique
  latitude         Float
  longitude        Float
  serviceRadiusKm  Float            @default(50)
  servicedPincodes String           // Comma-separated serviced pincodes
  address          String
  managerName      String
  contactNumber    String
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())

  stocks           WarehouseStock[]
  stockReservations StockReservation[]
  orders           Order[]
}

model WarehouseStock {
  id               String          @id @default(uuid())
  warehouseId      String
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity         Int             @default(0)
  reservedQuantity Int             @default(0)
  reorderThreshold Int             @default(10)

  @@unique([warehouseId, productId, variantId])
}

model StockReservation {
  id          String                 @id @default(uuid())
  orderId     String
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product                @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant?        @relation(fields: [variantId], references: [id])
  warehouseId String
  warehouse   Warehouse              @relation(fields: [warehouseId], references: [id])
  quantity    Int
  status      StockReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime               @default(now())

  @@index([orderId])
  @@index([warehouseId])
}

// ----------------------------------------------------
// SHOPPING: ORDERS, ITEMS, PAYMENTS, COUPONS, REVIEWS
// ----------------------------------------------------

model Coupon {
  id             String     @id @default(uuid())
  code           String     @unique
  description    String?
  discountType   CouponType @default(FIXED)
  discountValue  Float
  minOrderValue  Float      @default(0)
  maxDiscount    Float?
  validFrom      DateTime   @default(now())
  validTo        DateTime
  usageLimit     Int        @default(1000)
  usageCount     Int        @default(0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  orders         Order[]
}

model Order {
  id                  String        @id @default(uuid())
  orderNumber         String        @unique
  userId              String
  user                User          @relation(fields: [userId], references: [id])
  
  subtotalAmount      Float
  discountAmount      Float         @default(0)
  deliveryFee         Float         @default(0)
  taxAmount           Float         @default(0)
  totalAmount         Float
  
  status              OrderStatus   @default(PLACED)
  paymentMethod       String        @default("UPI")
  paymentStatus       PaymentStatus @default(PENDING)
  
  assignedWarehouseId String?
  assignedWarehouse   Warehouse?    @relation(fields: [assignedWarehouseId], references: [id])
  assignmentMode      String        @default("AUTO")
  
  shippingAddress     String        // JSON stringified address details
  trackingNumber      String?
  courierName         String?
  notes               String?
  cancellationReason  String?
  cancelledAt         DateTime?
  
  couponId            String?
  coupon              Coupon?       @relation(fields: [couponId], references: [id])
  
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  items               OrderItem[]
  payments            Payment[]
  stockReservations   StockReservation[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id           String          @id @default(uuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  productName  String
  variantTitle String?
  sku          String
  quantity     Int
  unitPrice    Float
  taxRate      Float           @default(0.05) // 5% standard agri input GST
  totalPrice   Float
}

model Payment {
  id                 String        @id @default(uuid())
  orderId            String
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentNumber      String        @unique
  provider           String        @default("RAZORPAY") // RAZORPAY | COD | WALLET
  amount             Float
  currency           String        @default("INR")
  status             PaymentStatus @default(PENDING)
  
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  idempotencyKey     String?       @unique
  failureReason      String?
  rawWebhookPayload  String?
  
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([orderId])
  @@index([razorpayOrderId])
}

model Review {
  id               String       @id @default(uuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerName     String
  rating           Int          @default(5)
  title            String
  comment          String
  verifiedPurchase Boolean      @default(true)
  status           ReviewStatus @default(APPROVED)
  createdAt        DateTime     @default(now())

  @@index([productId])
}

// ----------------------------------------------------
// CMS & CONTENT MANAGEMENT
// ----------------------------------------------------

model Banner {
  id           String   @id @default(uuid())
  title        String
  subtitle     String?
  imageUrl     String
  linkUrl      String
  buttonText   String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  location     String   @default("HOMEPAGE_HERO")
  createdAt    DateTime @default(now())
}

model BlogPost {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  excerpt         String
  content         String
  coverImage      String
  author          String    @default("Dr. B. R. Patil (Agronomist)")
  isPublished     Boolean   @default(true)
  publishedAt     DateTime  @default(now())
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FaqItem {
  id           String   @id @default(uuid())
  question     String
  answer       String
  category     String   @default("General")
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model CmsContent {
  id              String   @id @default(uuid())
  key             String   @unique // e.g. "PRIVACY_POLICY", "TERMS", "ABOUT_US"
  title           String
  content         String
  metaTitle       String?
  metaDescription String?
  updatedAt       DateTime @updatedAt
}

// ----------------------------------------------------
// NOTIFICATIONS & AUDIT LOGS
// ----------------------------------------------------

model CustomerNotification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String   // SMS | WHATSAPP | EMAIL | IN_APP
  recipient String
  event     String   // ORDER_PLACED | DISPATCHED | OUT_FOR_DELIVERY | DELIVERED
  title     String
  message   String
  status    String   @default("SENT")
  sentAt    DateTime @default(now())

  @@index([userId])
}

model NotificationLog {
  id        String   @id @default(uuid())
  channel   String
  recipient String
  event     String
  message   String
  status    String   @default("SENT")
  sentAt    DateTime @default(now())
}

// ----------------------------------------------------
// WALLET (OPTIONAL FEATURE)
// ----------------------------------------------------

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Float               @default(0)
  currency     String              @default("INR")
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  type        String   // CREDIT | DEBIT
  description String
  referenceId String?  // e.g. Order ID
  createdAt   DateTime @default(now())

  @@index([walletId])
}

// ----------------------------------------------------
// PRESERVED OPERATIONAL MODULES (FARM PROFILE, RENTALS, SERVICES, CRM, REPAIRS)
// ----------------------------------------------------

model FarmProfile {
  id               String              @id @default(uuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  district         String
  taluk            String
  villagePanchayat String
  state            String              @default("Karnataka")
  pincode          String
  surveyNumber     String?
  vleFpoNumber     String?
  acreage          Float
  gpsLatitude      Float?
  gpsLongitude     Float?
  distanceFromVle  String?
  jobWorkLocation  String?
  irrigationType   String
  farmOperations   String
  cropName         String
  cropCycleDays    Int
  sownDate         DateTime?
  activitySchedule String?
  popAttached      Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  cropStages       CropStageTracking[]
}

model CropStageTracking {
  id                      String      @id @default(uuid())
  farmProfileId           String
  farmProfile             FarmProfile @relation(fields: [farmProfileId], references: [id], onDelete: Cascade)
  stageNumber             Int
  stageName               String
  startDate               DateTime
  targetCompletionDate    DateTime?
  status                  String      @default("ACTIVE")
  soilCondition           String?
  notes                   String?
  productsUsed            String?
  nextRecommendedProducts String?
  followUpDate            DateTime?
  completedDate           DateTime?
  createdAt               DateTime    @default(now())
}

model RentalProduct {
  id              String          @id @default(uuid())
  title           String
  slug            String          @unique
  category        String
  description     String
  dailyRate       Float
  weeklyRate      Float
  monthlyRate     Float
  securityDeposit Float
  images          String
  isAvailable     Boolean         @default(true)
  createdAt       DateTime        @default(now())

  bookings        RentalBooking[]
}

model RentalBooking {
  id                  String        @id @default(uuid())
  bookingNumber       String        @unique
  userId              String
  user                User          @relation(fields: [userId], references: [id])
  rentalProductId     String
  rentalProduct       RentalProduct @relation(fields: [rentalProductId], references: [id])
  startDate           DateTime
  endDate             DateTime
  rentalDurationDays  Int
  totalRent           Float
  securityDeposit     Float
  status              RentalStatus  @default(PENDING)
  returnCondition     String?
  depositRefundStatus String        @default("PENDING")
  createdAt           DateTime      @default(now())
}

model ServiceType {
  id          String           @id @default(uuid())
  name        String
  code        String           @unique
  description String
  basePrice   Float
  category    String

  requests    ServiceRequest[]
}

model ServiceRequest {
  id                   String        @id @default(uuid())
  requestNumber        String        @unique
  userId               String
  user                 User          @relation(fields: [userId], references: [id])
  serviceTypeId        String
  serviceType          ServiceType   @relation(fields: [serviceTypeId], references: [id])
  gpsLatitude          Float?
  gpsLongitude         Float?
  address              String
  pincode              String
  preferredDate        DateTime
  preferredTime        String
  notes                String?
  photoUrl             String?
  status               ServiceStatus @default(REQUESTED)
  assignedProviderId   String?
  assignedProviderName String?
  createdAt            DateTime      @default(now())
}

model Lead {
  id                String     @id @default(uuid())
  customerName      String
  mobile            String
  email             String?
  source            String     @default("WEBSITE")
  status            LeadStatus @default(NEW)
  interestedItem    String?
  assignedAgentId   String?
  assignedAgentName String?
  notes             String?
  followUpDate      DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Dealer {
  id               String    @id @default(uuid())
  dealerCode       String    @unique
  businessName     String
  contactPerson    String
  mobile           String
  email            String?
  region           String
  tier             String    @default("SILVER")
  gstin            String?
  currentSales     Float     @default(0)
  targetSales      Float     @default(100000)
  earnedCommission Float     @default(0)
  pendingPayout    Float     @default(0)
  createdAt        DateTime  @default(now())

  jobCards         JobCard[]
}

model JobCard {
  id                  String        @id @default(uuid())
  jobCardNumber       String        @unique
  equipmentModel      String
  serialNumber        String
  category            String
  customerName        String
  customerMobile      String
  dealerId            String?
  dealer              Dealer?       @relation(fields: [dealerId], references: [id])
  technicianName      String?
  status              RepairStatus  @default(PRODUCT_RECEIVED)
  complaints          String
  inspectionChecklist String?
  diagnosisNotes      String?
  estimatedHours      Float         @default(1.0)
  estimatedLaborCost  Float         @default(300)
  estimatedPartsCost  Float         @default(0)
  finalTotal          Float         @default(0)
  invoiceNumber       String?
  paymentStatus       PaymentStatus @default(PENDING)
  warrantyStatus      String        @default("OUT_OF_WARRANTY")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model SparePart {
  id               String   @id @default(uuid())
  partNumber       String   @unique
  name             String
  category         String
  compatibleModels String
  purchasePrice    Float
  sellingPrice     Float
  stockQuantity    Int      @default(0)
  reorderLevel     Int      @default(5)
  createdAt        DateTime @default(now())
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model PackageOfPractice {
  id               String   @id @default(uuid())
  slNo             String   @unique
  date             DateTime @default(now())
  vleFpoNo         String?
  district         String
  taluk            String
  villagePanchayat String
  state            String   @default("Karnataka")
  name             String
  mobileNumber     String
  emailId          String?
  address          String
  surveyNumber     String
  acres            Float
  pinCode          String
  jobWorkLocation  String
  distanceFromVle  Float
  irrigation       String[]
  jobWork          String[]
  crop             String
  cropCycleDays    Int
  popAttached      String?
  schedule         Json
  status           String   @default("SUBMITTED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}