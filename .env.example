# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_ENV=production                                    # production | staging | development
PORT=3000
HOSTNAME=0.0.0.0

NEXT_PUBLIC_SITE_DOMAIN=agrimart.in
NEXT_PUBLIC_SITE_NAME="AGRI MART MEGA"
NEXT_PUBLIC_SITE_NAME_KN="ಅಗ್ರಿ ಮಾರ್ಟ್ ಮೆಗಾ"
NEXT_PUBLIC_APP_URL=https://www.agrimart.in
APP_URL=https://www.agrimart.in
NEXT_PUBLIC_TOLL_FREE=1800-425-2474

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / SQLite Storage)
# ------------------------------------------------------------------------------
# In containerized or managed PostgreSQL deployment:
# DATABASE_URL="postgresql://agrimart_user:SECURE_DB_PASSWORD@postgres-host:5432/agrimart_prod?schema=public&sslmode=prefer&connection_limit=20"
DATABASE_URL="file:./data/dev-database.json"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION, JWT & SESSION SECURITY
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_at_least_64_characters_long_in_production
JWT_EXPIRY=7d
SESSION_COOKIE_SECRET=your_session_cookie_secret_key_here
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=https://www.agrimart.in

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay India / PhonePe / PayU)
# ------------------------------------------------------------------------------
# Live production credentials from Razorpay Dashboard (Settings > API Keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_live_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_live_webhook_signing_secret
RAZORPAY_CURRENCY=INR

# ------------------------------------------------------------------------------
# 5. COMMUNICATIONS & NOTIFICATIONS MATRIX
# ------------------------------------------------------------------------------
# Telecom Regulatory Authority of India (TRAI) DLT Registered SMS Gateway
SMS_GATEWAY_PROVIDER=gupshup                          # gupshup | textlocal | fast2sms
SMS_DLT_ENTITY_ID=1101458920000034521
SMS_DLT_HEADER=AGRMKT
SMS_API_KEY=your_sms_gateway_api_key_here

# Meta WhatsApp Business Cloud API
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/your_phone_number_id/messages
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=109238475892341
WHATSAPP_BUSINESS_ACCOUNT_ID=9872341098234

# Transactional Email (SendGrid / AWS SES)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIAxxxxxxxxxxxxxxxx
SMTP_PASSWORD=your_aws_ses_smtp_password
EMAIL_FROM="AGRI MART MEGA <orders@agrimart.in>"

# ------------------------------------------------------------------------------
# 6. LOGISTICS & CARRIER API ADAPTERS
# ------------------------------------------------------------------------------
VRL_LOGISTICS_API_KEY=your_vrl_express_api_key
VRL_LOGISTICS_CUSTOMER_CODE=BLR_GREENSHIELD_01
DELHIVERY_API_TOKEN=your_delhivery_rural_api_token
DELHIVERY_CLIENT_ID=AGRIMART_MEGA

# ------------------------------------------------------------------------------
# 7. MAPS & GEOCODING
# ------------------------------------------------------------------------------
# Google Maps Platform / Mapbox for Farm Parcel & Dark Warehouse Routing
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxx
GEOCODING_CACHE_TTL_DAYS=30

# ------------------------------------------------------------------------------
# 8. CLOUD STORAGE & ASSET CDN (AWS S3 / Cloudflare R2)
# ------------------------------------------------------------------------------
S3_BUCKET_NAME=agrimart-production-assets
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
NEXT_PUBLIC_CDN_DOMAIN=cdn.agrimart.in

# ------------------------------------------------------------------------------
# 9. THIRD-PARTY ENTERPRISE SERVICES DIAGNOSTICS
# ------------------------------------------------------------------------------
# GoKwik 1-Click Fast Checkout
GOKWIK_APP_ID=gokwik_app_live_id
GOKWIK_APP_SECRET=gokwik_app_live_secret
